# apps/web — NEXT_PUBLIC_* values are safe to expose in the browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk server runtime (required by the Next.js proxy and NestJS verifier; never browser-exposed)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# apps/api — server only
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/lingora
WEB_ORIGIN=http://localhost:3000
PORT=3001
