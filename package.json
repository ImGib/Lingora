{
  "name": "lingora",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @lingora/contracts build && pnpm --parallel --filter @lingora/api --filter @lingora/web dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "pnpm -r lint && eslint 05-testing/e2e playwright.config.ts",
    "test": "pnpm --filter @lingora/contracts build && pnpm -r test",
    "typecheck": "pnpm --filter @lingora/contracts build && pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test:evidence": "node .agents/scripts/capture-evidence.mjs",
    "build:fast": "node .agents/scripts/fast-build.mjs",
    "build:web:fast": "node .agents/scripts/fast-build.mjs --target=web",
    "build:api:fast": "node .agents/scripts/fast-build.mjs --target=api",
    "verify:fast": "node .agents/scripts/fast-build.mjs --verify-only",
    "mcp:supabase": "node .agents/scripts/configure-supabase-mcp.mjs",
    "test:smoke": "node .agents/scripts/smoke-test.mjs",
    "test:ui-ux": "node .agents/scripts/ui-ux-test.mjs",
    "test:all": "pnpm verify:fast && pnpm test:ui-ux",
    "db:seed": "node 04-coding/apps/api/scripts/seed-database.mjs",
    "scout": "node .agents/scripts/code-scout.mjs",
    "scout:index": "node .agents/scripts/code-scout.mjs index",
    "skill": "node .agents/scripts/skill-scout.mjs",
    "know": "node .agents/scripts/skill-scout.mjs",
    "web": "node .agents/scripts/web-scout.mjs",
    "autogen": "node .agents/scripts/autogen-locator.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@clerk/backend": "3.19.0",
    "@clerk/testing": "2.2.4",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "8.16.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
