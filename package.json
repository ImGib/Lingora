{
  "name": "lingora",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @lingora/contracts build && pnpm --parallel --filter @lingora/api --filter @lingora/web dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "pnpm -r lint && eslint qa/e2e playwright.config.ts",
    "test": "pnpm --filter @lingora/contracts build && pnpm -r test",
    "typecheck": "pnpm --filter @lingora/contracts build && pnpm -r typecheck && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@clerk/backend": "3.19.0",
    "@clerk/testing": "2.2.4",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "8.16.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
